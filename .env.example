# Keys remain on the server. Leave blank to use demo mode.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=apodex/apodex-1.1-mini:free

# Optional: choose AI_PROVIDER=openai to use the original OpenAI integration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3001

# Hosting: leave NODE_ENV unset for local development.
# Set NODE_ENV=production on the hosting service, not in your local .env.
# Production defaults to HOST=0.0.0.0; local development defaults to 127.0.0.1.
# APP_ORIGIN=https://your-domain.example
# TRUST_PROXY=1  # Only when all requests pass through one trusted reverse proxy.

# Per-IP limits per 10 minutes. PDF uploads are limited separately to 8.
API_RATE_LIMIT=180
AI_RATE_LIMIT=20
# Counts provider attempts, including corrections/retries, per UTC day per process.
AI_DAILY_REQUEST_LIMIT=100
PDF_TIMEOUT_MS=30000
